{
  "version": "1",
  "default_decision": "deny",
  "rules": [
    {
      "name": "allow-step-up-admin-admin.read",
      "type": "allow",
      "action": "admin.read",
      "conditions": [
        {
          "field": "acr",
          "op": "equals",
          "value": "urn:qid:acr:phishing-resistant"
        }
      ]
    },
    {
      "name": "allow-step-up-admin-admin.write",
      "type": "allow",
      "action": "admin.write",
      "conditions": [
        {
          "field": "acr",
          "op": "equals",
          "value": "urn:qid:acr:phishing-resistant"
        }
      ]
    }
  ]
}
