{
  "version": "1",
  "default_decision": "deny",
  "rules": [
    {
      "name": "allow-authenticated-read",
      "type": "allow",
      "action": "read",
      "expression": {
        "not": {
          "field": "subject_id",
          "op": "equals",
          "value": ""
        }
      }
    },
    {
      "name": "allow-authenticated-userinfo",
      "type": "allow",
      "action": "userinfo",
      "expression": {
        "not": {
          "field": "subject_id",
          "op": "equals",
          "value": ""
        }
      }
    },
    {
      "name": "allow-authenticated-introspect",
      "type": "allow",
      "action": "introspect",
      "expression": {
        "not": {
          "field": "subject_id",
          "op": "equals",
          "value": ""
        }
      }
    }
  ]
}
