{
  "version": "1",
  "default_decision": "deny",
  "rules": [
    {
      "name": "allow-managed-device-egress-connect",
      "type": "allow",
      "action": "connect",
      "conditions": [
        {
          "field": "posture",
          "op": "contains",
          "value": "managed"
        }
      ]
    },
    {
      "name": "allow-managed-device-egress-http.forward",
      "type": "allow",
      "action": "http.forward",
      "conditions": [
        {
          "field": "posture",
          "op": "contains",
          "value": "managed"
        }
      ]
    }
  ]
}
