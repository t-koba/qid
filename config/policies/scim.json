{
  "version": "1",
  "default_decision": "deny",
  "rules": [
    {
      "name": "allow-provisioning-client-scim.read",
      "type": "allow",
      "action": "scim.read",
      "conditions": [
        {
          "field": "subject_id",
          "op": "equals",
          "value": "scim-provisioner"
        }
      ]
    },
    {
      "name": "allow-provisioning-client-scim.write",
      "type": "allow",
      "action": "scim.write",
      "conditions": [
        {
          "field": "subject_id",
          "op": "equals",
          "value": "scim-provisioner"
        }
      ]
    }
  ]
}
